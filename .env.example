GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MAX_BUDGET_USD=10.0
CLIENT_BASE_RATE=5%
CRAWLER_MAX_CASHBACK_PCT=30
CRAWLER_MAX_COMPETITORS=12
# Change detection — 5%→12% triggers spike when delta >= SPIKE_MIN_POINTS (default 2)
CRAWLER_SPIKE_MIN_POINTS=2.0
CRAWLER_SPIKE_MIN_RATIO=1.2
CRAWLER_DOM_CHANGE_THRESHOLD=0.88

# Phase C — Autonomous crawler / radar
CRAWLER_WORKERS=3
CRAWLER_VISION_ENABLED=true
# Visual intelligence: always | sparse (<3 DOM offers) | off
CRAWLER_VISUAL_MODE=always
CRAWLER_VISION_MODEL=gemini-2.0-flash
CRAWLER_PHASH_MAX_DISTANCE=14
# Optional local OCR (requires tesseract binary + pip install pytesseract)
CRAWLER_TESSERACT_ENABLED=false

# Enterprise intelligence
CRAWLER_ANOMALY_Z_THRESHOLD=2.5
CRAWLER_ANOMALY_HARD_RATIO=3.0
CRAWLER_PROXIES=
# Example: http://user:pass@proxy1:8080,http://proxy2:8080
RADAR_RUN_PIPELINE=false

# Adaptive autonomous crawling
# Comma-separated merchants; policy auto-adds HOT/HIGH-risk slugs
CRAWLER_WATCHLIST=Myntra,Ajio,Amazon,Nykaa,Flipkart
# Surveillance mode: python -m agents.crawler --surveillance
CRAWLER_MODE=surveillance
CRAWLER_RECRAWL_DELAY_SEC=120
CRAWLER_FOLLOW_LINKS_ON_CRITICAL=true
CRAWLER_ALWAYS_FULL_SCRAPE=false
CRAWLER_AUTO_DISABLE_DORMANT=false
CRAWLER_DORMANT_DISABLE_THRESHOLD=10

# Sprint 2 — budget, evidence, event sinks
MAX_CRAWL_COST_USD_PER_HOUR=2.0
MAX_VISION_CALLS_PER_MERCHANT_PER_DAY=10
MAX_LLM_FALLBACK_PER_RUN=3
CRAWLER_EVIDENCE_MISMATCH_PCT=3.0
CRAWLER_EVENT_WEBHOOK=
CRAWLER_EVENT_LOG_PATH=data/intelligence_stream.jsonl

# Sprint 3 — navigation, antibot, contracts
CRAWLER_CAMPAIGN_LINK_LIMIT=2
CRAWLER_SOURCE_COOLDOWN_MIN=20
CRAWLER_ANTIBOT_RETRY_DELAY_SEC=4.0
CRAWLER_VALIDATE_CONTRACT=true

# Set true to always run analyst+strategist after every crawl (higher cost)
SWARM_ALWAYS_PIPELINE=false

# Orchestrator control plane
ORCHESTRATOR_MAX_RETRIES=2
ORCHESTRATOR_RETRY_BACKOFF_SEC=2.0
ORCHESTRATOR_AGENT_TIMEOUT_SEC=60
ORCHESTRATOR_MAX_PARALLEL_MERCHANTS=1
ORCHESTRATOR_EVENT_POLL_SEC=5.0
ORCHESTRATOR_POLL_EVENT_LOG=true
ORCHESTRATOR_EVENT_INTEGRATION=true
# Webhook: python -m orchestrator --webhook-server [--port 8081]
ORCHESTRATOR_WEBHOOK_PORT=8081
# Optional shared secret (X-Orchestrator-Secret or Authorization: Bearer)
ORCHESTRATOR_WEBHOOK_SECRET=
# Dead-letter queue for contract failures
ORCHESTRATOR_DEAD_LETTER_PATH=logs/dead_letter.jsonl
# Cross-process state lock (single-writer recommended)
ORCHESTRATOR_STATE_LOCK=false
ORCHESTRATOR_STATE_LOCK_PATH=logs/orchestrator.state.lock
ORCHESTRATOR_STATE_LOCK_TIMEOUT_SEC=30

# Analyst agent (Groq Llama 3)
ANALYST_MODEL=llama-3.3-70b-versatile
ANALYST_SHADOW_MODEL=llama-3.1-8b-instant
ANALYST_SHADOW_ENABLED=true
ANALYST_USE_HISTORY=true
ANALYST_CACHE_ENABLED=true
ANALYST_CACHE_TTL_SEC=3600

# Strategist agent (Groq Llama 3)
STRATEGIST_MODEL=llama-3.3-70b-versatile
STRATEGIST_USE_PLAYBOOKS=true
# Runtime playbook merge: {"myntra":{"tone":"Custom festive tone"}}
# STRATEGIST_PLAYBOOK_JSON=
# Aliases / inline: myntra:default or myntra:{"tone":"Urgent"}
# STRATEGIST_PLAYBOOK_SLUGS=
# File-based approval queue (data/approvals/*.json)
STRATEGIST_APPROVAL_QUEUE=false
STRATEGIST_APPROVAL_DIR=data/approvals
# CLI: python -m agents.strategist [--list-pending | --approve ID | --veto ID]
# Demo: python -m agents.strategist

# Sprint 4 — distributed queue, browser pool, geo, metrics, worker
CRAWLER_GEO=IN
CRAWLER_CONTEXT_POOL_SIZE=4
CRAWLER_QUEUE_BACKEND=sqlite
# Optional Redis queue (pip install redis); falls back to SQLite if unavailable
# CRAWLER_QUEUE_BACKEND=redis
# CRAWLER_REDIS_URL=redis://localhost:6379/0
CRAWLER_WORKER_ID=
CRAWLER_WORKER_POLL_SEC=5
CRAWLER_WORKER_BATCH=3
CRAWLER_TASK_STALE_MINUTES=45

# Login / session persistence (Playwright storage state in data/sessions/{slug}.json)
CRAWLER_LOGIN_ENABLED=false
# Generic or per-merchant: CRAWLER_LOGIN_MYNTRA_USER / CRAWLER_LOGIN_MYNTRA_PASS
CRAWLER_LOGIN_USER=
CRAWLER_LOGIN_PASS=
# Optional login page URL (generic or CRAWLER_LOGIN_{SLUG}_URL)
CRAWLER_LOGIN_URL=

# Captcha / antibot (no paid solver unless key set — integration stub only)
CRAWLER_CAPTCHA_COOLDOWN_MIN=45
CRAWLER_CAPTCHA_RETRY_DELAY_SEC=8.0
CRAWLER_ANTIBOT_DOUBLE_PROXY=true
# CRAWLER_CAPTCHA_SOLVER_KEY=

# Metrics: python -m agents.crawler --metrics [--prometheus]

# Alerter — Slack / webhook / JSONL audit (python -m agents.alerter)
ALERTER_SLACK_ENABLED=false
ALERTER_WEBHOOK_ENABLED=false
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERTER_MIN_SEVERITY=warning
ALERTER_DEDUPE_TTL_SEC=3600
ALERTER_DEDUPE_PATH=data/alerter_dedupe.db
ALERTER_AUDIT_PATH=data/alerts.jsonl
ALERTER_QUIET_HOURS=23-07
ALERTER_USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
# HTTP scrape: python -m agents.crawler --serve-metrics --port 9090
